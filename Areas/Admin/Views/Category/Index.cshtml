@model IEnumerable<WebsiteShopping.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Quản lý danh mục</h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus fa-fw"></i> Thêm danh mục</a>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryId</td>
                            <td>@category.CategoryName</td>
                            <td>@category.Description</td>
                            <td>@category.Status</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn btn-primary btn-xs"><i class="fa fa-pencil"></i> Sửa</a>
                                <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i> Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>