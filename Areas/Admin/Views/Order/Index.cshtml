@model IEnumerable<WebsiteShopping.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">Order Management</h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        @TempData["Success"]
    </div>
}

<div class="panel panel-default">
    <div class="panel-heading">
        Order List
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Order Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var total = item.OrderDetails?.Sum(od => od.Quantity * od.UnitPrice) ?? 0;
                        <tr>
                            <td>#@item.OrderId</td>
                            <td>@item.CustomerName</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>$@total.ToString("N2")</td>
                            <td>
                                <span class="label @(item.Status == "Delivered" ? "label-success" : item.Status == "Cancelled" ? "label-danger" : item.Status == "Shipped" ? "label-info" : "label-warning")">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-info btn-xs"><i class="fa fa-eye"></i> View</a>
                                <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i> Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.OrderId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this order?');">
                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
